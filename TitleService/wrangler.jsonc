{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/",
  "name": "warren-title-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "title.warrenai.xyz",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warren-title-quota",
      "database_id": "4b051e0c-d94e-4b66-b445-71fc4dce4729",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "DEVICE_BURST",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "IP_BURST",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "DEVICE_DAILY_LIMIT": "50",
    "IP_DAILY_LIMIT": "300",
    "PUBLIC_POOL_DAILY_LIMIT": "2500"
  }
}
